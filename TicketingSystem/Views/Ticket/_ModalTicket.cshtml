@{
    bool permsCommentRead = ViewBag.PermsCommentRead ?? false;
    bool permsCommentAdd = ViewBag.PermsCommentAdd ?? false;
}

<!-- Modal Ticket Detail -->
<div class="modal fade" id="modalTicketDetail" tabindex="-1" aria-labelledby="modalTicketDetailLabel" aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalTicketDetailLabel">
                    <i class="bi bi-ticket-detailed me-2"></i>
                    Ticket Detail
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <!-- Tabs -->
                <ul class="nav nav-tabs mb-3" role="tablist">

                    <li class="nav-item" role="presentation">
                        <button class="nav-link active"
                                id="detail-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#ticket-detail"
                                type="button">
                            <i class="bi bi-info-circle me-1"></i>
                            Detail
                        </button>
                    </li>

                    <li class="nav-item" role="presentation">
                        <button class="nav-link"
                                id="history-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#ticket-history"
                                type="button">
                            <i class="bi bi-clock-history me-1"></i>
                            History
                        </button>
                    </li>

                    @if (permsCommentRead)
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link"
                                    id="discussion-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#ticket-discussion"
                                    type="button">
                                <i class="bi bi-chat-left-text me-1"></i>
                                Discussion
                            </button>
                        </li>
                    }

                </ul>

                <div class="tab-content">

                    <!-- DETAIL TAB -->
                    <div class="tab-pane fade show active" id="ticket-detail">

                        <div class="row g-3">

                            <div class="col-md-6">
                                <small class="text-secondary d-block">
                                    Ticket No
                                </small>

                                <span id="detailTicketNo" class="fw-semibold">
                                    -
                                </span>
                            </div>

                            <div class="col-md-6">
                                <small class="text-secondary d-block">
                                    Status
                                </small>

                                <span id="detailStatus" class="badge text-bg-secondary">
                                    -
                                </span>
                            </div>

                            <div class="col-12">
                                <small class="text-secondary d-block">
                                    Title
                                </small>

                                <span id="detailTitle" class="fw-semibold">
                                    -
                                </span>
                            </div>

                            <div class="col-md-6">
                                <small class="text-secondary d-block">
                                    Category
                                </small>

                                <span id="detailCategory">
                                    -
                                </span>
                            </div>

                            <div class="col-md-6">
                                <small class="text-secondary d-block">
                                    Priority
                                </small>

                                <span id="detailPriority"
                                      class="badge text-bg-secondary">
                                    -
                                </span>
                            </div>

                            <div class="col-md-6">
                                <small class="text-secondary d-block">
                                    Created By
                                </small>

                                <span id="detailCreatedBy">
                                    -
                                </span>
                            </div>

                            <div class="col-md-6">
                                <small class="text-secondary d-block">
                                    Assigned To
                                </small>

                                <span id="detailAssignedTo">
                                    -
                                </span>
                            </div>

                            <div class="col-12">
                                <small class="text-secondary d-block mb-1">
                                    Description
                                </small>

                                <div id="detailDescription" class="border rounded p-3 bg-body-tertiary"
                                     style="min-height: 100px;">
                                    -
                                </div>
                            </div>

                            <div class="col-12">
                                <hr />
                            </div>

                            <div class="col-md-6">
                                <small class="text-secondary d-block">
                                    Created At
                                </small>

                                <span id="detailCreatedAt">
                                    -
                                </span>
                            </div>

                            <div class="col-md-6">
                                <small class="text-secondary d-block">
                                    Updated At
                                </small>

                                <span id="detailUpdatedAt">
                                    -
                                </span>
                            </div>

                            <div class="col-md-6">
                                <small class="text-secondary d-block">
                                    Resolved At
                                </small>

                                <span id="detailResolvedAt">
                                    -
                                </span>
                            </div>

                            <div class="col-md-6">
                                <small class="text-secondary d-block">
                                    Closed At
                                </small>

                                <span id="detailClosedAt">
                                    -
                                </span>
                            </div>

                        </div>
                    </div>

                    <!-- HISTORY TAB -->
                    <div class="tab-pane fade" id="ticket-history">

                        <div id="ticketHistory" class="ticket-history-container">

                            <div class="text-center text-secondary py-3">
                                <div class="spinner-border spinner-border-sm me-1"
                                     role="status">
                                </div>

                                Loading history...
                            </div>

                        </div>
                    </div>

                    <!-- DISCUSSION TAB -->
                    @if (permsCommentRead)
                    {
                        <div class="tab-pane fade" id="ticket-discussion">

                            <div class="ticket-discussion">

                                <!-- Comments -->
                                <div id="ticketCommentContainer" class="ticket-discussion-list">
                                    <div class="text-center text-secondary py-3">
                                        No comments yet.
                                    </div>
                                </div>

                                @if (permsCommentAdd)
                                {
                                    <!-- Comment Input -->
                                    <form id="formTicketComment" class="ticket-discussion-form">

                                        <input type="hidden" id="commentTicketId" name="TicketId" />

                                        <textarea class="form-control" id="ticketComment" 
                                                  name="Comment"
                                                  rows="3"
                                                  maxlength="2000"
                                                  placeholder="Write a comment..."></textarea>

                                        <div class="ticket-discussion-actions">
                                            <button type="submit" class="btn btn-primary btn-sm">
                                                <i class="bi bi-send me-1"></i>
                                                Send
                                            </button>
                                        </div>

                                    </form>
                                }

                            </div>

                        </div>
                    }

                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Modal Ticket Create -->
<div class="modal fade" id="modalCreateTicket" tabindex="-1" aria-labelledby="modalCreateTicketLabel" aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalCreateTicketLabel">
                    <i class="bi bi-plus-circle me-2"></i>
                    Create Ticket
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <form id="formCreateTicket">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">
                                Title
                            </label>

                            <input type="text" id="createTitle" name="Title" class="form-control" maxlength="200" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Category
                            </label>

                            <select id="createCategory" name="CategoryId" asp-items="@ViewBag.CategoryList" class="form-select" required>
                                <option value="">
                                    Select Category
                                </option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Priority
                            </label>

                            <select id="createPriority" name="PriorityId" asp-items="@ViewBag.PriorityList" class="form-select" required>
                                <option value="">
                                    Select Priority
                                </option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Assigned To
                            </label>

                            <select id="createAssignedTo" name="AssignedTo" asp-items="@ViewBag.UserList" class="form-select">
                                <option value="">
                                    Unassigned
                                </option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Description</label>

                            <textarea id="createDescription" name="Description" class="form-control"
                                      rows="5"
                                      placeholder="Enter ticket description..."></textarea>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancel
                </button>

                <button type="button" class="btn btn-primary btn-sm" id="btnSaveTicket" onclick="CreateTicket()">
                    <i class="bi bi-save me-1"></i>
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ticket Update -->
<div class="modal fade" id="modalEditTicket" tabindex="-1" aria-labelledby="modalEditTicketLabel" aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalEditTicketLabel">
                    <i class="bi bi-pencil-square me-2"></i>
                    Edit Ticket
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <form id="formEditTicket">

                    <input type="hidden" id="editId" name="Id" />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">
                                Ticket No
                            </label>

                            <input type="text" id="editTicketNo" class="form-control" readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Status
                            </label>

                            <select id="editStatus" name="StatusId" asp-items="@ViewBag.StatusList" class="form-select" required>
                                <option value="">
                                    Select Status
                                </option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Title
                            </label>

                            <input type="text" id="editTitle" name="Title" class="form-control" maxlength="200" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Category
                            </label>

                            <select id="editCategory" name="CategoryId" asp-items="@ViewBag.CategoryList" class="form-select" required>
                                <option value="">
                                    Select Category
                                </option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Priority
                            </label>

                            <select id="editPriority" name="PriorityId" asp-items="@ViewBag.PriorityList" class="form-select" required>
                                <option value="">
                                    Select Priority
                                </option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Assigned To
                            </label>

                            <select id="editAssignedTo" name="AssignedTo" asp-items="@ViewBag.UserList" class="form-select">
                                <option value="">
                                    Unassigned
                                </option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                Description
                            </label>

                            <textarea id="editDescription" name="Description" class="form-control" rows="5">
                            </textarea>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">

                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancel
                </button>

                <button type="button" class="btn btn-primary btn-sm" id="btnUpdateTicket" onclick="UpdateTicket()">
                    <i class="bi bi-save me-1"></i>
                    Update
                </button>

            </div>

        </div>
    </div>

</div>